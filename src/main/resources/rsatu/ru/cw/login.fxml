<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="20" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="rsatu.ru.cw.LoginController"
      style="-fx-background-color: linear-gradient(to bottom, #ffebee, #ffcdd2);">

    <padding><Insets bottom="30" left="30" right="30" top="30"/></padding>

    <VBox alignment="CENTER" spacing="5">
        <Label text="🏠 Квартплата" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>
        <Label text="Вход в систему" style="-fx-font-size: 14px; -fx-text-fill: #d32f2f;"/>
    </VBox>

    <VBox spacing="0" maxWidth="350" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 15, 0, 0, 3);">

        <HBox spacing="0" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 12 12 0 0;">
            <Button fx:id="loginButton" text="🔐 Вход"
                    onAction="#switchToLogin"
                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 14 0 14 0; -fx-cursor: hand; -fx-background-radius: 12 0 0 0;"
                    maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>

            <Button fx:id="registerButton" text="📝 Регистрация"
                    onAction="#switchToRegister"
                    style="-fx-background-color: #ffcdd2; -fx-text-fill: #c62828; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 14 0 14 0; -fx-cursor: hand; -fx-background-radius: 0 12 0 0;"
                    maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox fx:id="loginPanel" spacing="15" style="-fx-background-color: white; -fx-background-radius: 0 0 12 12; -fx-padding: 25;">
            <TextField fx:id="loginField" promptText="Логин"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px;"/>

            <PasswordField fx:id="passwordField" promptText="Пароль"
                           style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px;"/>

            <Button onAction="#handleLogin" text="Войти"
                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand; -fx-font-size: 14px;"/>
        </VBox>

        <VBox fx:id="registerPanel" spacing="15" style="-fx-background-color: white; -fx-background-radius: 0 0 12 12; -fx-padding: 25;" visible="false" managed="false">
            <TextField fx:id="regLoginField" promptText="Логин"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px;"/>

            <PasswordField fx:id="regPasswordField" promptText="Пароль"
                           style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px;"/>

            <TextField fx:id="regApartmentField" promptText="Номер квартиры"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px;"/>

            <Button onAction="#handleRegister" text="Зарегистрироваться"
                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand; -fx-font-size: 14px;"/>
        </VBox>
    </VBox>
</VBox>