<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="10" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rsatu.ru.cw.LoginController">

    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Система расчёта квартплаты" />

    <TabPane fx:id="tabPane">
        <Tab closable="false" text="Вход">
            <VBox spacing="10">
                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                <Label text="Логин:" />
                <TextField fx:id="loginField" />
                <Label text="Пароль:" />
                <PasswordField fx:id="passwordField" />
                <Button onAction="#handleLogin" text="Войти" />
            </VBox>
        </Tab>
        <Tab closable="false" text="Регистрация">
            <VBox spacing="10">
                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                <Label text="Логин:" />
                <TextField fx:id="regLoginField" />
                <Label text="Пароль:" />
                <PasswordField fx:id="regPasswordField" />
                <Label text="Номер квартиры:" />
                <TextField fx:id="regApartmentField" />
                <Button onAction="#handleRegister" text="Зарегистрироваться" />
            </VBox>
        </Tab>
    </TabPane>
</VBox>
