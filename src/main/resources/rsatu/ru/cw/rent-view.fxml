<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="15" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="rsatu.ru.cw.RentController"
      style="-fx-background-color: linear-gradient(to bottom, #ffebee, #ffcdd2);">

    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <Label text="🏠 Система расчёта квартплаты" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>

    <HBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-border-color: #ef9a9a; -fx-border-radius: 8; -fx-padding: 10;">
        <Label text="🔢 Номер квартиры:" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
        <TextField fx:id="apartmentNumberField" prefWidth="120" promptText="Введите номер"
                   style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
    </HBox>

    <TitledPane expanded="true" text="📊 Показания счётчиков">
        <style>
            .titled-pane .title {
            -fx-background-color: #ffebee;
            -fx-border-color: #ef9a9a;
            -fx-border-radius: 8;
            }
            .titled-pane .title .text {
            -fx-fill: #c62828;
            -fx-font-weight: bold;
            }
            .titled-pane .content {
            -fx-background-color: white;
            -fx-border-color: #ef9a9a;
            -fx-border-radius: 8;
            }
        </style>
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>
            <Label text="⚡ Электричество (кВт·ч):" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
            <TextField fx:id="electricityReadingField" promptText="Введите показания" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
            <Label text="💧 Холодная вода (м³):" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
            <TextField fx:id="waterReadingField" promptText="Введите показания" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
        </GridPane>
    </TitledPane>

    <HBox alignment="CENTER" spacing="15">
        <Button onAction="#handleCalculate" text="🧮 Рассчитать"
                style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 25; -fx-cursor: hand;"/>
        <Button onAction="#handleShowDebt" text="📋 Показать долг"
                style="-fx-background-color: #ffcdd2; -fx-text-fill: #c62828; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 25; -fx-cursor: hand;"/>
    </HBox>

    <TitledPane expanded="true" text="💳 Оплата">
        <HBox alignment="CENTER" spacing="15">
            <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>
            <Label text="💰 Сумма платежа:" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
            <TextField fx:id="paymentAmountField" prefWidth="120" promptText="0.00"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
            <Button onAction="#handlePay" text="💳 Оплатить"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>
    </TitledPane>

    <Label fx:id="debtLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #d32f2f; -fx-background-color: #ffebee; -fx-padding: 8; -fx-background-radius: 6;"/>

    <TitledPane expanded="true" text="📄 Квитанция" VBox.vgrow="ALWAYS">
        <TextArea fx:id="receiptArea" editable="false" wrapText="true"
                  style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-font-family: 'Courier New', monospace; -fx-font-size: 12px;"/>
    </TitledPane>
</VBox>