<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rsatu.ru.cw.AdminController"
      style="-fx-background-color: linear-gradient(to bottom, #ffebee, #ffcdd2);">

    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <Label text="👑 Панель администратора" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>

    <HBox spacing="10">
        <Button text="🏢 Управление квартирами" onAction="#handleManageApartments"
                style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button text="🔄 Обновить" onAction="#handleRefresh"
                style="-fx-background-color: #ffcdd2; -fx-text-fill: #c62828; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;"/>
    </HBox>

    <TableView fx:id="apartmentTable" prefHeight="200"
               style="-fx-background-color: white; -fx-border-color: #ef9a9a; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colNumber" text="№ квартиры" prefWidth="80"/>
            <TableColumn fx:id="colOwner" text="Владелец" prefWidth="200"/>
            <TableColumn fx:id="colDebt" text="Долг/Переплата" prefWidth="150"/>
        </columns>
    </TableView>

    <Label fx:id="apartmentInfoLabel" text="Выберите квартиру из списка"
           style="-fx-text-fill: #424242; -fx-background-color: #ffebee; -fx-padding: 8; -fx-background-radius: 6;"/>

    <TitledPane text="⚡ Начисление для выбранной квартиры" expanded="true">
        <style>
            .titled-pane .title {
            -fx-background-color: #ffebee;
            -fx-border-color: #ef9a9a;
            -fx-border-radius: 8;
            }
            .titled-pane .title .text {
            -fx-fill: #c62828;
            -fx-font-weight: bold;
            }
            .titled-pane .content {
            -fx-background-color: white;
            -fx-border-color: #ef9a9a;
            -fx-border-radius: 8;
            }
        </style>
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>
            <Label text="⚡ Электричество (кВт·ч):" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
            <TextField fx:id="electricityReading" promptText="Введите показания" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
            <Label text="💧 Холодная вода (м³):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
            <TextField fx:id="waterReading" promptText="Введите показания" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
            <Button text="💰 Начислить" onAction="#handleChargeSelected" GridPane.rowIndex="2" GridPane.columnSpan="2"
                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-cursor: hand;"/>
        </GridPane>
    </TitledPane>

    <TitledPane text="📄 Квитанция" expanded="true" VBox.vgrow="ALWAYS">
        <TextArea fx:id="receiptArea" editable="false" wrapText="true"
                  style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-font-family: 'Courier New', monospace; -fx-font-size: 12px;"/>
    </TitledPane>
</VBox>