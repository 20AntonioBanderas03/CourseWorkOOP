<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rsatu.ru.cw.ResidentController"
      style="-fx-background-color: linear-gradient(to bottom, #ffebee, #ffcdd2);">

    <MenuBar style="-fx-background-color: #d32f2f; -fx-border-color: #c62828;">
        <menus>
            <Menu text="Действия" style="-fx-text-fill: white;">
                <items>
                    <Menu text="Показать сведения" style="-fx-text-fill: #c62828;">
                        <items>
                            <MenuItem text="Об авторе" onAction="#handleAboutAuthor"/>
                            <MenuItem text="Об аккаунте" onAction="#handleAboutAccount"/>
                        </items>
                    </Menu>
                    <SeparatorMenuItem/>
                    <MenuItem text="Выход" onAction="#handleExit"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>

    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <Label text="👤 Личный кабинет жильца" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>
    <Label fx:id="apartmentLabel" style="-fx-font-size: 14px; -fx-text-fill: #424242; -fx-background-color: #ffebee; -fx-padding: 8; -fx-background-radius: 6;"/>
    <Label fx:id="debtLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #d32f2f; -fx-background-color: #ffebee; -fx-padding: 8; -fx-background-radius: 6;"/>

    <TitledPane text="📊 Показания счётчиков" expanded="true" style="-fx-background-color: transparent;">
        <style>
            .titled-pane {
            -fx-text-fill: #c62828;
            }
            .titled-pane .title {
            -fx-background-color: #ffebee;
            -fx-border-color: #ef9a9a;
            -fx-border-radius: 8;
            -fx-background-radius: 8;
            }
            .titled-pane .title .text {
            -fx-fill: #c62828;
            -fx-font-weight: bold;
            }
            .titled-pane .content {
            -fx-background-color: white;
            -fx-border-color: #ef9a9a;
            -fx-border-radius: 8;
            -fx-background-radius: 8;
            }
        </style>
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>
            <Label text="⚡ Электричество (кВт·ч):" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
            <TextField fx:id="electricityReading" promptText="Введите показания" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
            <Label text="💧 Холодная вода (м³):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
            <TextField fx:id="waterReading" promptText="Введите показания" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
            <Button text="📤 Отправить показания" onAction="#handleSendReadings" GridPane.rowIndex="2" GridPane.columnSpan="2"
                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-cursor: hand;"/>
        </GridPane>
    </TitledPane>

    <TitledPane text="💰 Оплата" expanded="true">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>
            <Label text="💵 Сумма (руб):" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
            <TextField fx:id="paymentAmount" promptText="0.00" prefWidth="120"
                       style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
            <Button text="💳 Оплатить" onAction="#handlePay"
                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>
    </TitledPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="📋 Показать состояние" onAction="#handleShowReceipt"
                style="-fx-background-color: #ffcdd2; -fx-text-fill: #c62828; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button text="📋 Показать состояние (всплывающее)" onAction="#handleShowReceiptPopup"
                style="-fx-background-color: #ffcdd2; -fx-text-fill: #c62828; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
    </HBox>

    <TitledPane text="📄 Информация" expanded="true" VBox.vgrow="ALWAYS">
        <TextArea fx:id="receiptArea" editable="false" wrapText="true"
                  style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-font-family: 'Courier New', monospace; -fx-font-size: 12px;"/>
    </TitledPane>
</VBox>