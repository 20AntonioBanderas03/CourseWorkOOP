<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rsatu.ru.cw.ResidentController">

    <MenuBar>
        <menus>
            <Menu text="Действия">
                <items>
                    <Menu text="Показать сведения">
                        <items>
                            <MenuItem text="Об авторе" onAction="#handleAboutAuthor"/>
                            <MenuItem text="Об аккаунте" onAction="#handleAboutAccount"/>
                        </items>
                    </Menu>
                    <SeparatorMenuItem/>
                    <MenuItem text="Выход" onAction="#handleExit"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <Label text="Личный кабинет жильца" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="apartmentLabel" style="-fx-font-size: 14px;"/>
    <Label fx:id="debtLabel" style="-fx-font-size: 14px; -fx-text-fill: red;"/>

    <TitledPane text="Показания счётчиков" expanded="true">
        <GridPane hgap="10" vgap="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Электричество (кВт·ч):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="electricityReading" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Холодная вода (м³):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="waterReading" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Button text="Отправить показания" onAction="#handleSendReadings" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
        </GridPane>
    </TitledPane>

    <TitledPane text="Оплата" expanded="true">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Сумма (руб):"/>
            <TextField fx:id="paymentAmount" prefWidth="120"/>
            <Button text="Оплатить" onAction="#handlePay"/>
        </HBox>
    </TitledPane>

    <HBox spacing="10">
        <Button text="Показать состояние" onAction="#handleShowReceipt"/>
        <Button text="Показать состояние(всплывающее окно)" onAction="#handleShowReceiptPopup"/>
    </HBox>

    <TitledPane text="Информация" expanded="true" VBox.vgrow="ALWAYS">
        <TextArea fx:id="receiptArea" editable="false" wrapText="true"/>
    </TitledPane>
</VBox>