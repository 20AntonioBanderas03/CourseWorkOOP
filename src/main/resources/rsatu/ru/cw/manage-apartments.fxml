<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="rsatu.ru.cw.ManageApartmentsController"
      style="-fx-background-color: linear-gradient(to bottom, #ffebee, #ffcdd2);">

    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <Label text="🏢 Управление квартирами" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>

    <TableView fx:id="apartmentTable" prefHeight="250"
               style="-fx-background-color: white; -fx-border-color: #ef9a9a; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colNumber" text="№ квартиры" prefWidth="80"/>
            <TableColumn fx:id="colArea" text="Площадь (кв.м)" prefWidth="100"/>
            <TableColumn fx:id="colResidents" text="Жильцов" prefWidth="80"/>
            <TableColumn fx:id="colOwner" text="Владелец" prefWidth="200"/>
            <TableColumn fx:id="colDebt" text="Долг/Переплата" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="🔄 Обновить" onAction="#handleRefresh"
                style="-fx-background-color: #ffcdd2; -fx-text-fill: #c62828; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button text="➕ Добавить" onAction="#handleAddApartment"
                style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button text="✏ Редактировать" onAction="#handleEditApartment"
                style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
        <Button text="🗑 Удалить" onAction="#handleDeleteApartment"
                style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;"/>
    </HBox>

    <Separator style="-fx-background-color: #ef9a9a;"/>

    <Label text="📝 Данные квартиры" style="-fx-font-weight: bold; -fx-text-fill: #c62828; -fx-font-size: 14px;"/>

    <GridPane hgap="10" vgap="10" style="-fx-background-color: white; -fx-border-color: #ef9a9a; -fx-border-radius: 8; -fx-padding: 15;">
        <Label text="Номер квартиры:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
        <TextField fx:id="numberField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Введите номер"
                   style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>

        <Label text="Площадь (кв.м):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
        <TextField fx:id="areaField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Введите площадь"
                   style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>

        <Label text="Количество жильцов:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
        <TextField fx:id="residentsField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Введите количество"
                   style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>

        <Label text="ФИО владельца:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #424242; -fx-font-weight: bold;"/>
        <TextField fx:id="ownerField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Введите ФИО"
                   style="-fx-background-color: #fafafa; -fx-border-color: #ef9a9a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>

        <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnSpan="2">
            <Button text="💾 Сохранить" onAction="#handleSave"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Button text="🗑 Очистить" onAction="#handleClear"
                    style="-fx-background-color: #ffcdd2; -fx-text-fill: #c62828; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>
    </GridPane>

    <Label fx:id="statusLabel" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;"/>
</VBox>